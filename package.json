{
  "name": "open-volleyball",
  "version": "2.0.0-alpha.7",
  "private": true,
  "type": "module",
  "description": "Gestion locale de tournois de volleyball",
  "author": "Open Volleyball contributors",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run start",
    "test": "vitest run",
    "test:ui": "playwright test",
    "package": "npm run build && electron-builder --win portable --x64",
    "sample": "tsx scripts/sample.ts",
    "models:fetch": "node scripts/fetch-registration-model.mjs",
    "reader:prepare": "node scripts/prepare-advanced-reader.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "lucide-react": "^0.468.0",
    "pdfkit": "^0.17.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "jsqr": "1.4.0",
    "onnxruntime-web": "1.30.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "prettier": "^3.9.10",
    "qrcode": "1.5.4",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "ch.openvolleyball.desktop",
    "productName": "Open Volleyball",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "!assets/models/registration/**/*",
      "!assets/models/registration-fr/**/*",
      "node_modules/pdfkit/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/volleyball.ico",
      "target": "portable",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Open-Volleyball-${version}-Windows.exe"
    }
  },
  "overrides": {
    "@huggingface/transformers": {
      "onnxruntime-web": "1.30.0"
    }
  }
}
